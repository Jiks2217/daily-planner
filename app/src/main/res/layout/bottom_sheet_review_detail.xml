<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="#FFFFFF">
    <View android:layout_width="40dp" android:layout_height="4dp" android:background="#E0E0E0" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp"/>
    <TextView android:id="@+id/tvDetailDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monday, Jan 1" android:textSize="20sp" android:textStyle="bold" android:textColor="#1A1A1A" />
    <TextView android:id="@+id/tvDetailScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Score: 85/100" android:textSize="16sp" android:textColor="#4CAF50" android:textStyle="bold" android:layout_marginBottom="24dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accomplishment" android:textStyle="bold" android:textColor="#666666" android:textSize="14sp"/>
    <TextView android:id="@+id/tvDetailAcc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="None" android:textSize="16sp" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Challenges" android:textStyle="bold" android:textColor="#666666" android:textSize="14sp"/>
    <TextView android:id="@+id/tvDetailChal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="None" android:textSize="16sp" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Improvements" android:textStyle="bold" android:textColor="#666666" android:textSize="14sp"/>
    <TextView android:id="@+id/tvDetailImp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="None" android:textSize="16sp" android:layout_marginBottom="24dp"/>
</LinearLayout>
